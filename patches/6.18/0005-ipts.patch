@@ -967,12 +974,12 @@ static void domain_unmap(struct dmar_domain *domain, unsigned long start_pfn,
 			 struct iommu_pages_list *freelist)
 {
 	if (WARN_ON(!domain_pfn_supported(domain, last_pfn)) ||
