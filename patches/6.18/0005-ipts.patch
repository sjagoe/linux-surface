@@ -708,8 +715,8 @@ void dmar_fault_dump_ptes(struct intel_iommu *iommu, u16 source_id,
 #endif
 
 static struct dma_pte *pfn_to_dma_pte(struct dmar_domain *domain,
-				      unsigned long pfn, int *target_level,
-				      gfp_t gfp)
+					  unsigned long pfn, int *target_level,
+					  gfp_t gfp)
 {
 	struct dma_pte *parent, *pte;
 	int level = agaw_to_level(domain->agaw);
@@ -735,7 +742,7 @@ static struct dma_pte *pfn_to_dma_pte(struct dmar_domain *domain,
 			uint64_t pteval, tmp;
 
 			tmp_page = iommu_alloc_pages_node_sz(domain->nid, gfp,
-							     SZ_4K);
+								 SZ_4K);
 
 			if (!tmp_page)
 				return NULL;
@@ -807,7 +814,7 @@ static void dma_pte_clear_range(struct dmar_domain *domain,
 	struct dma_pte *first_pte, *pte;
 
