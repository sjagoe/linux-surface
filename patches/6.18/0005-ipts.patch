@@ -557,7 +564,7 @@ static struct intel_iommu *device_lookup_iommu(struct device *dev, u8 *bus, u8 *
 }
 
 static void domain_flush_cache(struct dmar_domain *domain,
-			       void *addr, int size)
+				   void *addr, int size)
 {
